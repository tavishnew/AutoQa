# App server
DATABASE_URL=postgres://user:password@host:5432/autoqa
BETTER_AUTH_URL=http://localhost:3000/api/auth

# Encryption — generate with: openssl rand -base64 32
# Must be identical in app .env and worker/.env
LLM_KEY_ENC=

# Optional: Ollama (default http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Optional: NVIDIA NIM (https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct

# Optional: OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
